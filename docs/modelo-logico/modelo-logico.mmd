erDiagram
    PESSOA {
        BIGINT_AUTO_INCREMENT id_pessoa PK "NOT NULL"
        VARCHAR_150 nome  "NOT NULL"
        VARCHAR_4 tipo_documento  "NOT NULL"
        VARCHAR_14 numero_documento  "NOT NULL"
        VARCHAR_20 telefone  "NOT NULL"
        VARCHAR_254 email  "NULL permitido (exigido ao assinar contrato)"
        VARCHAR_150 logradouro  "NULL permitido (exigido ao assinar contrato)"
        VARCHAR_10 numero  "NULL permitido (exigido ao assinar contrato)"
        VARCHAR_60 complemento  "NULL permitido"
        VARCHAR_80 bairro  "NULL permitido (exigido ao assinar contrato)"
        VARCHAR_80 cidade  "NULL permitido (exigido ao assinar contrato)"
        CHAR_2 estado_uf  "NULL permitido (exigido ao assinar contrato)"
        TINYINT_1 possui_cnh "NULL permitido"
    }
    FUNCIONARIO {
        BIGINT_AUTO_INCREMENT id_funcionario PK "NOT NULL"
        BIGINT id_pessoa FK, UK "NOT NULL"
        VARCHAR_80 cargo  "NOT NULL"
        DATE data_admissao  "NOT NULL"
        VARCHAR_10 situacao  "NOT NULL"
    }
    VEICULO {
        BIGINT_AUTO_INCREMENT id_veiculo PK "NOT NULL"
        VARCHAR_60 marca  "NOT NULL"
        VARCHAR_80 modelo  "NOT NULL"
        SMALLINT ano_modelo  "NOT NULL"
        VARCHAR_30 cor  "NOT NULL"
        VARCHAR_7 placa UK "NULL permitido"
        VARCHAR_17 chassi UK "NULL permitido"
        VARCHAR_20 combustivel  "NOT NULL"
        VARCHAR_20 cambio  "NOT NULL"
        VARCHAR_8 categoria_comercial  "NOT NULL"
    }
    ATENDIMENTO {
        BIGINT_AUTO_INCREMENT id_atendimento PK "NOT NULL"
        BIGINT id_pessoa FK "NOT NULL"
        BIGINT id_funcionario FK "NOT NULL"
        DATETIME data  "NOT NULL"
        VARCHAR_6 tipo_interesse  "NOT NULL"
        TEXT descricao_interesse  "NOT NULL"
        VARCHAR_13 situacao  "NOT NULL"
        TEXT observacoes  "NULL permitido"
    }
    LAUDO {
        BIGINT_AUTO_INCREMENT id_laudo PK "NOT NULL"
        BIGINT id_veiculo FK "NOT NULL"
        VARCHAR_80 referencia_documental  "NOT NULL"
        DATE data_emissao  "NULL permitido (exigido quando EMITIDO)"
        VARCHAR_10 situacao  "NOT NULL"
        TEXT resultado  "NULL permitido (exigido quando EMITIDO)"
    }
    AVALIACAO {
        BIGINT_AUTO_INCREMENT id_avaliacao PK "NOT NULL"
        BIGINT id_veiculo FK "NOT NULL"
        BIGINT id_avaliador FK "NOT NULL"
        DATETIME data  "NOT NULL"
        VARCHAR_14 finalidade  "NOT NULL"
        INT quilometragem  "NOT NULL"
        INT quantidade_proprietarios  "NULL permitido"
        VARCHAR_120 condicao_externa  "NULL permitido"
        VARCHAR_120 condicao_interna  "NULL permitido"
        VARCHAR_120 condicao_mecanica  "NULL permitido"
        VARCHAR_120 condicao_estrutural  "NULL permitido"
        VARCHAR_120 condicao_documental  "NULL permitido"
        VARCHAR_10 decisao_tecnica  "NOT NULL"
        VARCHAR_10 interesse_comercial  "NOT NULL"
        TEXT justificativa  "NULL permitido"
    }
    AVALIACAO_LAUDO {
        BIGINT id_avaliacao PK, FK "NOT NULL"
        BIGINT id_laudo FK "NOT NULL"
    }
    ENTRADA {
        BIGINT_AUTO_INCREMENT id_entrada PK "NOT NULL"
        BIGINT id_veiculo FK "NOT NULL"
        BIGINT id_contraparte FK "NOT NULL"
        BIGINT id_avaliacao FK, UK "NOT NULL"
        BIGINT id_venda_origem FK "NULL permitido"
        BIGINT id_entrada_anterior FK, UK "NULL permitido"
        VARCHAR_14 modalidade  "NOT NULL"
        DATETIME data_entrada  "NOT NULL"
        VARCHAR_18 situacao  "NOT NULL"
        DATETIME data_encerramento  "NULL permitido"
        VARCHAR_32 motivo_encerramento  "NULL permitido"
        DATETIME data_regularizacao  "NULL permitido"
        TEXT observacoes_regularizacao  "NULL permitido"
        DECIMAL_14_2 valor_acordado  "NOT NULL"
        DECIMAL_14_2 preco_anunciado  "NULL permitido"
        VARCHAR_40 numero_contrato  "NULL permitido"
        DATE data_emissao  "NULL permitido"
        TEXT termos_ajustes  "NULL permitido"
        VARCHAR_12 reconhecimento_firma  "NULL permitido"
        DATE prazo_consignacao  "NULL permitido"
        DECIMAL_14_2 valor_repasse_acordado  "NULL permitido"
        VARCHAR_50 prazo_repasse  "NULL permitido"
        TEXT criterio_repasse  "NULL permitido"
        DATETIME data_devolucao  "NULL permitido"
        BIGINT veiculo_vigente UK "GENERATED STORED, NULL permitido (RN13: uma entrada vigente por veiculo)"
    }
    VENDA {
        BIGINT_AUTO_INCREMENT id_venda PK "NOT NULL"
        BIGINT id_comprador FK "NOT NULL"
        BIGINT id_funcionario FK "NOT NULL"
        BIGINT id_entrada_principal FK, UK "NOT NULL"
        BIGINT id_laudo FK "NULL permitido"
        DATETIME data_registro  "NOT NULL"
        VARCHAR_18 situacao_comercial  "NOT NULL"
        DATETIME data_conclusao  "NULL permitido"
        DECIMAL_14_2 valor_base  "NOT NULL"
        DECIMAL_14_2 desconto  "NOT NULL"
        DECIMAL_14_2 acrescimo  "NOT NULL"
        DECIMAL_14_2 taxas  "NOT NULL"
        DECIMAL_14_2 valor_total  "GENERATED VIRTUAL, NULL permitido"
        VARCHAR_40 numero_contrato  "NULL permitido"
        DATE data_emissao  "NULL permitido"
        TEXT termos_condicoes  "NULL permitido"
        TINYINT_1 condicao_repasse "NOT NULL"
        DECIMAL_14_2 valor_recebido  "NOT NULL"
        DATETIME data_ultimo_recebimento  "NULL permitido"
        VARCHAR_100 instituicao_financeira  "NULL permitido"
        DECIMAL_14_2 valor_financiado  "NULL permitido"
        VARCHAR_20 situacao_financiamento  "NULL permitido"
        DATETIME data_aprovacao_financiamento  "NULL permitido"
        DATETIME data_recebimento_financiamento  "NULL permitido"
        DATETIME data_scanner  "NULL permitido"
        VARCHAR_100 resultado_scanner  "NULL permitido"
        TEXT providencias_scanner  "NULL permitido"
        TEXT preparacao  "NULL permitido"
        DATETIME data_entrega  "NULL permitido"
        TINYINT_1 concessao_garantia "NOT NULL"
        TEXT termos_politica  "NULL permitido"
        DATETIME data_cancelamento  "NULL permitido"
        TEXT motivo_cancelamento  "NULL permitido"
        DATETIME data_retorno_veiculo  "NULL permitido"
        DECIMAL_14_2 valor_restituido_loja  "NULL permitido"
        DATETIME data_aviso_consignante  "NULL permitido"
        TEXT orientacao_bancaria  "NULL permitido"
        TEXT observacoes_cancelamento  "NULL permitido"
    }
    FORMA_PAGAMENTO {
        VARCHAR_20 codigo PK "NOT NULL"
        VARCHAR_40 descricao UK "NOT NULL"
    }
    VENDA_FORMA_PAGAMENTO {
        BIGINT id_venda PK, FK "NOT NULL"
        VARCHAR_20 codigo_forma PK, FK "NOT NULL"
    }
    VENDA_DOCUMENTO {
        BIGINT id_venda PK, FK "NOT NULL"
        VARCHAR_24 tipo_documento PK "NOT NULL"
        DATETIME data_conferencia  "NULL permitido"
        TINYINT_1 reconhecimento_aplicavel "NOT NULL"
        DATETIME data_reconhecimento  "NULL permitido"
        TEXT justificativa_dispensa  "NULL permitido"
    }
    OCORRENCIA_GARANTIA {
        BIGINT_AUTO_INCREMENT id_ocorrencia PK "NOT NULL"
        BIGINT id_venda FK "NOT NULL"
        BIGINT id_mecanico FK "NULL permitido"
        DATETIME data_abertura  "NOT NULL"
        TEXT problema_relatado  "NOT NULL"
        VARCHAR_14 atendimento_externo_informado  "NOT NULL"
        TEXT diagnostico  "NULL permitido"
        VARCHAR_12 responsabilidade_apurada  "NULL permitido"
        TEXT servico_realizado  "NULL permitido"
        TEXT solucao  "NULL permitido"
        VARCHAR_16 situacao  "NOT NULL"
        DATETIME data_encerramento  "NULL permitido"
    }
    DESPESA {
        BIGINT_AUTO_INCREMENT id_despesa PK "NOT NULL"
        BIGINT id_veiculo FK "NOT NULL"
        DATE data  "NOT NULL"
        VARCHAR_11 categoria  "NOT NULL"
        TEXT descricao  "NOT NULL"
        DECIMAL_14_2 valor  "NOT NULL"
    }

